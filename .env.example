# ═══════════════════════════════════════════════════════
# Flight Finder — API Keys
# Copy this to .env.local and fill in your keys
# ═══════════════════════════════════════════════════════

# Amadeus Self-Service API (https://developers.amadeus.com)
# Used for: Flight search, airport autocomplete
NEXT_PUBLIC_AMADEUS_API_KEY=
NEXT_PUBLIC_AMADEUS_API_SECRET=

# Skyscanner via RapidAPI (https://rapidapi.com/apiheya/api/sky-scrapper)
# Used for: Flight search, airport search, geo-pricing
NEXT_PUBLIC_RAPIDAPI_KEY=

# Without API keys, the app uses realistic simulated data
# with deep-links to real booking platforms.
