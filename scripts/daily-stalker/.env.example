# ── API Keys (set at least one; without any, the report has booking links only, no prices) ──
RAPIDAPI_KEY=your_rapidapi_key_here
AMADEUS_API_KEY=your_amadeus_client_id_here
AMADEUS_API_SECRET=your_amadeus_client_secret_here
# Free Amadeus self-service keys only work on the TEST host. Use 'production' only with production keys.
AMADEUS_ENV=test

# ── Email (Gmail App Password or SendGrid SMTP) ──
# For Gmail: enable 2FA, then generate an App Password at
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_TO=alhumudab@gmail.com

# ── Optional ──
# DRY_RUN=true            # Write report.html instead of sending email
# ALLOW_SIMULATION=true   # Demo only: fill gaps with ESTIMATED prices (always labelled). Default off.
# SAMPLE_DATES=3          # Dates sampled per destination for Skyscanner (calls/day ≈ 15 × this)
# SKYSCANNER_MAX_CALLS=45 # Hard daily cap — set to fit your RapidAPI plan's quota
# CONCURRENCY=4           # Max simultaneous HTTP requests
# SEARCH_DAYS_MIN=30    # Start of search window (default 30)
# SEARCH_DAYS_MAX=60    # End of search window (default 60)
