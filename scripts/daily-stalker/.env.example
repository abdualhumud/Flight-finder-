# ── API Keys (at least one recommended; simulation fallback always works) ──
RAPIDAPI_KEY=your_rapidapi_key_here
AMADEUS_API_KEY=your_amadeus_client_id_here
AMADEUS_API_SECRET=your_amadeus_client_secret_here

# ── Email (Gmail App Password or SendGrid SMTP) ──
# For Gmail: enable 2FA, then generate an App Password at
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_TO=alhumudab@gmail.com

# ── Optional ──
# DRY_RUN=true          # Print email to console instead of sending
# SEARCH_DAYS_MIN=30    # Start of search window (default 30)
# SEARCH_DAYS_MAX=60    # End of search window (default 60)
